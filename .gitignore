# OS / Editor
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.venv
venv/
.env
.env.*
!.env.example
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# Node (if present)
node_modules/
dist/
build/
.cache/
coverage/

# ============================================================================
# PROJECT-SPECIFIC: Credentials & Secrets (NEVER commit!)
# ============================================================================

# Platform-specific environment files (contain passwords)
scripts/windows/env.ps1
scripts/macos/env.sh
~/.secrets/envision_env.*

# ============================================================================
# GENERATED ARTIFACTS (Re-generatable; do not commit for size/cleanliness)
# ============================================================================

# ML models (trained via scripts/ml/; regenerate with training pipeline)
models/**/*.pkl
models/**/*.pkl.bak
data/artifacts/**/*.pkl
data/artifacts/**/*.pkl.bak

# Vectorizers and other trained components
data/artifacts/event_vectorizer*
data/artifacts/*_vectorizer*

# Runtime cache (rebuilt on next run; very large)
data/cache/
data/cache/**/*.html
data/cache/**/*.json
media_hash_cache.json

# Event images (re-downloadable from original sources)
data/event_images/**/*.jpg
data/event_images/**/*.jpeg
data/event_images/**/*.png
data/event_images/**/*.webp

# ============================================================================
# OUTPUT & LOGS (Generated at runtime; do not commit)
# ============================================================================

# Pipeline execution artifacts
output/
output/logs/**/*.log
output/logs/**/*.json
output/pipeline/**/*.csv
output/pipeline/**/*.json
output/analytics/

# Regeneration/enhancement logs
regenerate_descriptions/**/*.log
scripts/pipeline/regenerate_descriptions/**/*.log

# ============================================================================
# DATA FILES (Source-of-truth or intermediate; selective rules)
# ============================================================================

# Intermediate/development CSVs (keep only consolidated_events_labeled.csv as source-of-truth)
data/processed/canonical_labeled_training_*.csv
data/processed/training_snapshot_*.csv
data/raw/perdido_events_backup*.csv
data/raw/perdido_events_sept*.csv
data/labeled/*_backup.csv
data/labeled/*_old.csv

# NOTE: data/labeled/consolidated_events_labeled.csv is the source-of-truth
# and should be committed; other CSVs in this section are intermediates

# ============================================================================
# PLUGINS & BUILDS
# ============================================================================

# Plugin builds and distributions
plugins/builds/
plugins/**/*.zip
plugins/**/*.tar.gz

# Container runtime data
container-data/

# ============================================================================
# DEBUG & TESTING (Local-only scripts with embedded creds)
# ============================================================================

# Debug scripts that contain credentials (do not commit)
check_*.py
!scripts/dev/check_evcal_srow.py
compare_events.py
fix_eventon_metadata.py
test_wordpress_upload.py
debug_*.py

# Test fixtures with large data (re-generatable)
tests/fixtures/**/*.csv
tests/fixtures/**/*.pkl
tests/fixtures/**/*.json

# ============================================================================
# IDE & LOCAL DEVELOPMENT
# ============================================================================

.venvEnvisionPerdido/
.ipynb_checkpoints/
*.egg-info/
